{
  "name": "ksw-vue-icon",
  "version": "2.3.0",
  "license": "ISC",
  "description": "KSW ICON",
  "type": "module",
  "main": "packages/cjs/index.js",
  "module": "packages/es/index.js",
  "types": "packages/es/index.d.ts",
  "files": [
    "styles",
    "icons-base.json",
    "icons-guangfa.json",
    "packages/*/*.js",
    "packages/*/*/*.js",
    "packages/*/*/*/*.js",
    "packages/*/*.d.ts",
    "packages/*/*/*.d.ts",
    "packages/*/*/*/*.d.ts"
  ],
  "repository": "https://github.com/sengoku-f/KSW-vue-icon",
  "peerDependencies": {
    "vue": "^3.4.21"
  },
  "exports": {
    ".": {
      "import": "./packages/es/index.js",
      "require": "./packages/cjs/index.js"
    },
    "./styles/*.css": {
      "import": "./styles/*.css",
      "require": "./styles/*.css"
    }
  }
}
